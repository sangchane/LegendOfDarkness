{
  "permissions": {
    "allow": [
      "Bash(git status --ignore-submodules=all:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(dotnet test mobile/tests/Lod.Mobile.Core.Tests/Lod.Mobile.Core.Tests.csproj:*)",
      "Bash(dotnet test tests/hades-characterization/Hades.Characterization.Tests.csproj:*)"
    ],
    "deny": [
      "Read(./mobile/client/build/**)",
      "Read(./mobile/client/.godot/**)",
      "Read(./experiments/*/build/**)",
      "Read(./experiments/*/.godot/**)",
      "Read(./.tools/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/bin/**)",
      "Read(./**/obj/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/guard_shell.py\""
          },
          {
            "type": "command",
            "if": "Bash(cp *)",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/guard_shell.py\""
          },
          {
            "type": "command",
            "if": "Bash(mv *)",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/guard_shell.py\""
          },
          {
            "type": "command",
            "if": "Bash(rsync *)",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/guard_shell.py\""
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/guard_shell.py\""
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/prefer_docs_over_artifact.py\""
          }
        ]
      }
    ]
  }
}
