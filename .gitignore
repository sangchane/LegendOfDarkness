# Local secrets and machine-specific configuration
.env
.env.*
!.env.example
*.user
*.suo

# Workspace-only output
.tools/
logs/
tmp/
*.log

# Python 바이트코드
__pycache__/
*.pyc

# OS/editor files
.DS_Store
Thumbs.db
*.swp
*.swo

# Local downloads dropped into sources/ and browser-tool output (never commit)
sources/*.zip
sources/*.exe
sources/Dark-Ages-Private-Server-master/
sources/novaonline/
# ↑ 서버팩 zip 을 푼 것 195MB. 필요한 텍스트는 data/server-packs/novaonline/ 에 있다
.playwright-mcp/

# .NET build output
[Bb]in/
[Oo]bj/

# Graphify 지식 그래프 산출물 — 로컬에서 언제든 다시 만든다 (graphify .)
graphify-out/

# 원작 자료 노트 — data/game-data/*.json 에서 언제든 다시 만든다 (scripts/build-game-data.ps1)
data/game-data/vault/

# 서버팩 자료 노트 — data/server-packs/extracted/*.json 에서 언제든 다시 만든다
# (scripts/build-server-pack-vault.py)
data/server-packs/vault/
# ↑ 이것만 무시한다. 43MB · 파일 11,015개로 커서 저장소에 올리지 않는다.
#
# **나머지 볼트는 올린다.** 생성물이지만 볼트는 **읽으려고 만든 것**이고, 다른 기기에서
# 다시 만들려면 포크 submodule·dotnet·PowerShell 이 필요하다 — 그걸 안 하려고 만든 것이
# 볼트다. 합쳐 4.5MB · 파일 1,131개다:
#   data/truth-vault/               자료가 어디서 오는가 (scripts/build-truth-vault.py)
#   data/formula-vault/             세계가 굴러가는 식   (scripts/build-formula-vault.py)
#   data/archives-vault/            아카이브 503표      (scripts/build-archive-vault.py)
#   data/game-data/vault-abilities/ 원작 기술·마법 613   (scripts/build-ability-vault.py)
data/server-packs/graph/
# 역어셈블 그래프 — data/disassembly/findings.json 에서 언제든 다시 만든다 (scripts/build-disassembly-graph.py)
data/disassembly/graph/

