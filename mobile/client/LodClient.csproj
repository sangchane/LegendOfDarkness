<Project Sdk="Godot.NET.Sdk/4.6.0">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>LodClient</RootNamespace>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);android/**;build/**</DefaultItemExcludes>
  </PropertyGroup>
  <!--
    iOS 는 AOT 로 게시된다. 그때 ILC 가 내는 트림·AOT 분석 경고는 전부 GodotSharp 안에서 나오는 것이라
    우리 코드로는 없앨 수 없는데, 작업공간의 TreatWarningsAsErrors 가 그것을 오류로 올려 게시를 통째로
    실패시킨다. 그리고 Godot 은 그 실패를 감춘 채 .ipa 를 만든다 — C# 프레임워크가 빠진 채로. 그러면
    앱은 기기에서 엔진이 올라온 직후 죽는다. 우리 코드의 경고는 그대로 오류로 둔다(데스크톱 빌드).
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('ios'))">
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Lod.Mobile.Core/Lod.Mobile.Core.csproj" />
  </ItemGroup>

</Project>
